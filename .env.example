# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------

# Required. Bot token from the Discord developer portal.
DISCORD_TOKEN=your_bot_token_here

# Guild to register slash commands in. Registering per-guild is instant;
# global registration takes up to an hour to propagate.
DISCORD_GUILD_ID=123456789012345678

# Channel the bot scans for promo codes. When unset, the bot scans every
# channel it can see.
DISCORD_CHANNEL_ID=123456789012345679

# Discord user/bot ID that posts promo codes (e.g. the Idle Champions
# combinations bot). When set, only messages from this author are scanned --
# both live and during backfill. Leaving it empty means any member who can post
# in DISCORD_CHANNEL_ID can trigger redemption attempts on every registered
# account, so setting it is strongly recommended.
DISCORD_CODE_AUTHOR_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_PATH=./data/idle.db

# Override the migrations folder. Set in the Docker image, where the compiled
# binary and its migrations do not sit at the repository paths. Leave unset for
# local development.
# MIGRATIONS_PATH=/app/dist-bundle/migrations

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Required. Encrypts the credentials stored in the database (userId, userHash).
# Must be a 64-character hex string (32 random bytes). The bot exits at startup
# if this is missing or malformed. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here

# Set to 1 ONLY if the Idle Champions API is serving an expired or otherwise
# invalid certificate. This disables certificate validation for requests to that
# host alone. Do not set NODE_TLS_REJECT_UNAUTHORIZED instead -- that turns
# validation off for every outbound connection, including the Discord gateway,
# which would expose DISCORD_TOKEN to anyone able to intercept the traffic.
# IDLE_CHAMPIONS_INSECURE_TLS=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: error, warn, info, debug, trace. Defaults to info.
# debug and trace are suppressed at the default level, so raise this to see the
# per-request API logging when diagnosing a failing redemption.
# LOG_LEVEL=info
